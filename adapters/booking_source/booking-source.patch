+"""Optional EventHub snapshot outbox; network I/O stays outside booking transactions."""
+from datetime import timedelta
+import json
+import uuid
+from urllib.error import HTTPError, URLError
+from urllib.parse import urlsplit
+from urllib.request import HTTPRedirectHandler, ProxyHandler, Request, build_opener
+
+from django.conf import settings
+from django.core.exceptions import ImproperlyConfigured
+from django.db import transaction
+from django.db.models import Q
+from django.utils import timezone
+
+from booking.models import EventHubOutbox
+
+
+def queue_snapshot(booking):
+    if not transaction.get_connection().in_atomic_block:
+        raise RuntimeError("Snapshots must be written inside the booking transaction")
+    booking.event_revision += 1
+    booking.save(update_fields=["event_revision"])
+    if not settings.EVENTHUB_ENABLED:
+        return
+    event_id = uuid.uuid4()
+    EventHubOutbox.objects.create(
+        id=event_id, booking=booking,
+        payload={
+            "specversion": "1.0", "id": str(event_id), "source": settings.EVENTHUB_SOURCE,
+            "type": "studio.booking.snapshot.v1", "subject": f"booking/{booking.pk}",
+            "time": timezone.now().isoformat(), "datacontenttype": "application/json",
+            "data": {"booking_id": str(booking.pk), "revision": booking.event_revision, "status": booking.status},
+        },
+    )
+
+
+class NoRedirect(HTTPRedirectHandler):
+    def redirect_request(self, req, fp, code, msg, headers, newurl):
+        return None
+
+
+def send(packet):
+    url, key = settings.EVENTHUB_URL, settings.EVENTHUB_API_KEY
+    parsed = urlsplit(url)
+    local = parsed.hostname in {"localhost", "127.0.0.1", "::1"}
+    if (parsed.scheme != "https" and not (local and parsed.scheme == "http")) or parsed.username or parsed.password or parsed.query or parsed.fragment or not key:
+        raise ImproperlyConfigured("EventHub requires HTTPS or a local HTTP endpoint and a private source key")
+    body = json.dumps(packet, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode()
+    opener = build_opener(ProxyHandler({}), NoRedirect())
+    request = Request(url.rstrip("/") + "/v1/events", data=body, headers={"Content-Type": "application/json", "Authorization": "Bearer " + key}, method="POST")
+    try:
+        with opener.open(request, timeout=10) as response:
+            return response.status, 0
+    except HTTPError as error:
+        value = error.headers.get("Retry-After", "0")
+        error.close()
+        return error.code, min(300, int(value)) if value.isdecimal() else 0
+    except (URLError, TimeoutError, OSError):
+        return None, 0
+
+
+def publish_batch(*, limit=50, sender=send):
+    if not settings.EVENTHUB_ENABLED:
+        return {"accepted": 0, "deferred": 0, "failed": 0}
+    counts = {"accepted": 0, "deferred": 0, "failed": 0}
+    for _ in range(limit):
+        current, token = timezone.now(), uuid.uuid4()
+        with transaction.atomic():
+            row = (EventHubOutbox.objects.select_for_update(skip_locked=True)
+                   .filter(state="pending", next_at__lte=current)
+                   .filter(Q(lease_until__isnull=True) | Q(lease_until__lte=current))
+                   .order_by("created_at", "pk").first())
+            if row is None:
+                break
+            row.lease_token, row.lease_until = token, current + timedelta(seconds=30)
+            row.attempts += 1
+            row.save(update_fields=["lease_token", "lease_until", "attempts"])
+            payload, row_id = row.payload, row.pk
+        # Neither booking rows nor outbox locks are held during HTTP.
+        status, retry_after = sender(payload)
+        with transaction.atomic():
+            row = EventHubOutbox.objects.select_for_update().get(pk=row_id)
+            if row.lease_token != token or row.lease_until <= timezone.now():
+                continue
+            row.lease_token = row.lease_until = None
+            if status in {200, 202}:
+                row.state, row.last_error = "accepted", ""
+                row.sent_at = timezone.now()
+                counts["accepted"] += 1
+            elif row.attempts >= 12 or (status is not None and status not in {408, 429} and status < 500):
+                row.state, row.last_error = "failed", f"http_{status}" if status else "retry_budget"
+                counts["failed"] += 1
+            else:
+                row.last_error = f"http_{status}" if status else "network"
+                row.next_at = timezone.now() + timedelta(seconds=max(retry_after, min(300, 2 ** row.attempts)))
+                counts["deferred"] += 1
+            row.save()
+    return counts
