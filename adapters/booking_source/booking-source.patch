+"""Transactional source tests; only the opt-in live test makes HTTP requests."""
+from datetime import timedelta
+import os
+from unittest import skipUnless
+from unittest.mock import patch
+
+from django.db import transaction
+from django.test import TestCase, override_settings
+from django.utils import timezone
+
+from booking.eventhub import publish_batch, send
+from booking.models import Booking, EventHubOutbox
+from booking.services import cancel, expire_due_holds
+from booking.test_workflow import BookingData
+
+
+@override_settings(EVENTHUB_ENABLED=True, EVENTHUB_SOURCE="urn:studio:booking-test")
+class EventHubSourceTests(BookingData, TestCase):
+    def test_status_snapshots_are_minimal_monotonic_and_retries_stable(self):
+        booking = self.make_hold()
+        self.pay(booking)
+        cancel(booking_id=booking.pk, customer=self.user)
+        rows = list(EventHubOutbox.objects.order_by("created_at"))
+        self.assertEqual([r.payload["data"]["revision"] for r in rows], [1, 2, 3])
+        self.assertEqual([r.payload["data"]["status"] for r in rows], ["held", "confirmed", "cancelled"])
+        self.assertEqual(set(rows[0].payload["data"]), {"booking_id", "revision", "status"})
+        self.assertNotIn(self.user.email, str([r.payload for r in rows]))
+        seen = []
+        def lost(packet):
+            seen.append(packet)
+            return None, 0
+        self.assertEqual(publish_batch(sender=lost)["deferred"], 3)
+        EventHubOutbox.objects.update(next_at=timezone.now() - timedelta(seconds=1))
+        def accepted(packet):
+            self.assertIn(packet, seen)
+            return 200, 0
+        self.assertEqual(publish_batch(sender=accepted)["accepted"], 3)
+        self.assertEqual(publish_batch(sender=accepted)["accepted"], 0)
+
+    def test_transaction_rollback_does_not_leave_events(self):
+        with self.assertRaises(RuntimeError):
+            with transaction.atomic():
+                self.make_hold()
+                raise RuntimeError("roll back fake business operation")
+        self.assertEqual(EventHubOutbox.objects.count(), 0)
+        self.assertEqual(Booking.objects.count(), 0)
+
+    def test_expiry_queues_exactly_one_new_revision(self):
+        booking = self.make_hold()
+        Booking.objects.filter(pk=booking.pk).update(hold_expires_at=timezone.now() - timedelta(seconds=1))
+        expire_due_holds()
+        expire_due_holds()
+        self.assertEqual(list(EventHubOutbox.objects.order_by("created_at").values_list("payload__data__revision", flat=True)), [1, 2])
+        self.assertEqual(EventHubOutbox.objects.latest("created_at").payload["data"]["status"], "expired")
+
+    def test_permanent_conflict_stops_instead_of_retrying(self):
+        self.make_hold()
+        self.assertEqual(publish_batch(sender=lambda packet: (409, 0))["failed"], 1)
+        self.assertEqual(publish_batch(sender=lambda packet: (202, 0))["accepted"], 0)
+
+    def test_receiver_slow_response_does_not_hold_outbox_transaction(self):
+        self.make_hold()
+        def sender(packet):
+            row = EventHubOutbox.objects.get(pk=packet["id"])
+            self.assertIsNotNone(row.lease_token)
+            return 202, 0
+        self.assertEqual(publish_batch(sender=sender)["accepted"], 1)
+
+    @override_settings(EVENTHUB_ENABLED=False)
+    def test_disabled_integration_does_not_enqueue(self):
+        booking = self.make_hold()
+        booking.refresh_from_db()
+        self.assertEqual(booking.event_revision, 1)
+        self.assertEqual(EventHubOutbox.objects.count(), 0)
+
+    @skipUnless(os.environ.get("EVENTHUB_TEST_KEY"), "Live EventHub source key is not configured")
+    def test_real_http_source_round_trip(self):
+        with override_settings(EVENTHUB_API_KEY=os.environ["EVENTHUB_TEST_KEY"], EVENTHUB_URL="http://127.0.0.1:8100"):
+            booking = self.make_hold()
+            self.pay(booking)
+            cancel(booking_id=booking.pk, customer=self.user)
+            counts = publish_batch(sender=send)
+            self.assertEqual(counts, {"accepted": 3, "deferred": 0, "failed": 0})
