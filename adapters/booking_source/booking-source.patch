+import json
+import time
+
+from django.conf import settings
+from django.core.management.base import BaseCommand, CommandError
+
+from booking.eventhub import publish_batch
+
+
+class Command(BaseCommand):
+    help = "Publish committed booking snapshots to the configured EventHub endpoint"
+
+    def add_arguments(self, parser):
+        parser.add_argument("--once", action="store_true")
+
+    def handle(self, *args, **options):
+        if not settings.EVENTHUB_ENABLED:
+            raise CommandError("EventHub is disabled. Configure the private source key and opt in first.")
+        try:
+            while True:
+                counts = publish_batch()
+                if options["once"] or any(counts.values()):
+                    self.stdout.write(json.dumps(counts))
+                if options["once"]:
+                    return
+                time.sleep(2)
+        except KeyboardInterrupt:
+            return
